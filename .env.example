DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek/deepseek-flash
# Background live response-quality judge (adds one judge-model sample per answer).
LIVE_QUALITY_EVALUATION_ENABLED=true
# Defaults to DEEPSEEK_MODEL; configure provider credentials for an override.
LIVE_QUALITY_JUDGE_MODEL=deepseek/deepseek-flash
LIVE_QUALITY_THRESHOLD=0.7
ANALYSIS_USER_ID=local-user
# Optional: set a different location for the SQLite ADK session database.
# ADK_SESSION_DB_PATH=
